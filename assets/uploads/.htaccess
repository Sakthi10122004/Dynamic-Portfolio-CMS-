# Allow image files to be served from uploads
Options -Indexes -ExecCGI

# Block PHP execution in uploads directory (security)
<FilesMatch "\.php$">
    Require all denied
</FilesMatch>

# Allow image and document types
<FilesMatch "\.(jpg|jpeg|png|gif|webp|pdf|doc|docx)$">
    Require all granted
</FilesMatch>

# Set correct MIME types
AddType image/webp .webp
AddType image/jpeg .jpg .jpeg
